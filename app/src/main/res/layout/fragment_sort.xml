<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingTop="16dp">

    <TextView
        android:id="@+id/rename_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:text="@string/sort_by"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/icon"
        app:layout_constraintTop_toTopOf="parent" />

    <com.example.googletasksclone.customviews.ListItemView
        android:id="@+id/my_order"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:iconVisibility="true"
        app:titleText="@string/my_order" />

    <com.example.googletasksclone.customviews.ListItemView
        android:id="@+id/date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:iconVisibility="false"
        app:titleText="@string/date"
        tools:iconVisibility="true" />

    <com.example.googletasksclone.customviews.ListItemView
        android:id="@+id/starred"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:iconVisibility="false"
        app:titleText="@string/starred_recently"
        tools:iconVisibility="true" />

</LinearLayout>